# punched-pwd environment variables
# Copy this file to .env.local and fill in real values.
# This is a TEMPLATE ONLY - never commit real credentials here.
#
# NOTE: .env.local is required for `npm run dev` to reach the Dockerized API.
# Without it the client falls back to http://localhost:5000/v1 (wrong port).

# Base URL the browser uses to reach the API.
#  - Local dev (web runs via `npm run dev`, API in Docker): http://localhost:8080/v1
#  - Local full-stack dev (API launched directly on this machine): adjust to the API port
NEXT_PUBLIC_API_URL=http://localhost:8080/v1

# PostgreSQL connection string (example format only).
# Replace USER/PASSWORD/HOST/PORT/DATABASE with your values in .env.local.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
CONNECTION_STRING=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Reference layout for your database (do NOT paste real values here):
# Host : db.example.com
# Database : your_database
# Role : your_user
# Password : set in .env.local (never committed)
# Pooler host : pooler.example.com