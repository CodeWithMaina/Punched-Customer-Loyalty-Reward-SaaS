# punched-pwd environment variables
# Copy this file to .env.local and fill in real values.
# This is a TEMPLATE ONLY - never commit real credentials here.

NEXT_PUBLIC_API_URL=http://localhost:5091/v1

# PostgreSQL connection string (example format only).
# Replace USER/PASSWORD/HOST/PORT/DATABASE with your values in .env.local.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
CONNECTION_STRING=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Reference layout for your database (do NOT paste real values here):
# Host : db.example.com
# Database : your_database
# Role : your_user
# Password : set in .env.local (never committed)
# Pooler host : pooler.example.com