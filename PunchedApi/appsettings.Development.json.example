{
  "//": "Copy this file to appsettings.Development.json and edit with LOCAL dev values only. Never commit real cloud credentials.",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=punched_db;Username=postgres;Password=changeme;SSL Mode=Prefer;"
  },
  "JwtSettings": {
    "Secret": "dev-secret-key-for-local-testing-only-change-in-production-32chars!!",
    "Issuer": "PunchedApi",
    "Audience": "PunchedApp",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "Seed": {
    "Enabled": true,
    "ResetDatabase": false,
    "ClearExistingData": false,
    "AppendData": false,
    "GenerateReport": true,
    "RandomSeed": 12345,
    "BusinessCount": 5,
    "VerboseLogging": true,
    "ReportPath": "seed-report.json"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Punched"
  }
}
